# Copie para .env e preencha. Nunca commite o arquivo .env.
#
# Opção 1 — só visualizar a interface (sem banco, dados fictícios):
#   VITE_UX_DEMO=1
#
# Opção 2 — usar com um banco Supabase (recomendado: projeto de teste, não o de produção).
# Somente a chave PÚBLICA (anon / sb_publishable_) vai nas variáveis VITE_.
VITE_UX_DEMO=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# Variáveis de servidor (defina no ambiente de hospedagem; nunca em arquivos commitados):
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# CRM_SESSION_SECRET=
# CRM_FULL_ACCESS_PASSWORD=
# CRM_LIMITED_ACCESS_PASSWORD=
